# cp .env.example .env  — never commit .env

# Lark app (Developer Console → your app)
LARK_OPEN_API_BASE=https://open-sg.larksuite.com/open-apis
LARK_APP_ID=cli_xxx
LARK_APP_SECRET=
LARK_VERIFICATION_TOKEN=            # Event Subscriptions page
LARK_ENCRYPT_KEY=                   # leave empty unless you turned encryption on

# Where MonitorFlow (Provider_test_automation) posts, and who that bot is
ALERT_CHAT_ID=oc_xxx
ALERT_BOT_SENDER_ID=                # see README "Find the alert bot's sender id"
FIXED_GROUP_CHAT_ID=                # empty = same group as alerts (reply under the alert message)
LARK_POLL_INTERVAL_SEC=0            # 0 = events only. Set 60 if Lark does not deliver events for bot messages.

# PagerDuty Events API v2 (from Jeno: test service integration key)
PD_ROUTING_KEY=
PD_STATUS_SECRET=change-me          # Zoho Flow must send header X-Status-Secret with this value
POST_PD_STATUS_TO_THREAD=0          # 1 only if Zoho Flow cannot reply in the thread itself
# REST API (only for the Acknowledge / Resolve buttons on the Lark card). User API token, not the integration key.
PD_API_KEY=
PD_FROM_EMAIL=                      # your PagerDuty login email; PagerDuty requires a From header on writes

# AI
# AI notes on the PagerDuty card (one per state). AI_BACKEND=claude_code runs the Claude Code CLI headless
# on the Claude Code subscription, no API key needed; on a server run `claude setup-token` once and put the
# token in CLAUDE_CODE_OAUTH_TOKEN. AI_BACKEND=anthropic uses ANTHROPIC_API_KEY instead. off = no AI calls.
AI_BACKEND=claude_code
AI_NOTES=1
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SEC=90
CLAUDE_BIN=claude
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# HTTPS (server only, read by the caddy container in docker-compose.yml, not by the bot)
# Caddy listens on 8443 and gets its certificate with the Let's Encrypt DNS challenge through the Namecheap API.
# Namecheap → Profile → Tools → "Namecheap API Access": enable, copy the key, whitelist the server's public IP.
NAMECHEAP_API_KEY=
NAMECHEAP_API_USER=                 # your Namecheap account username
NAMECHEAP_CLIENT_IP=                # the ECS public IP, the same one you whitelisted

# Behaviour
DEFAULT_WAIT_MINUTES=5
SWEEP_INTERVAL_SEC=30
DATABASE_PATH=alert_ir.sqlite3
POLICY_PATH=policy.yaml
DRY_RUN=1                           # 1 = log instead of calling Lark/PagerDuty. Set 0 when creds are in.
