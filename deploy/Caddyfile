# Replace with the DNS name whose A record points at the ECS public IP.
# Inbound 443 must be open to 0.0.0.0/0: Lark and Zoho call it, and Let's Encrypt (no fixed IPs)
# connects to it once to verify the domain before issuing the certificate (TLS-ALPN challenge,
# so port 80 is not required). Caddy fetches and renews the certificate itself.
alert-ir.example.com {
    # access log: one JSON line per request, "remote_ip" = who really called (Lark / Zoho source IPs).
    # The bot itself only ever sees Caddy's Docker address, so this is the place to check callers.
    log
    reverse_proxy bot:8080
}
